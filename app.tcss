Screen { background: #0b1220; color: #dbe5f4; }
Header { background: #15243b; color: #78e5d0; }
#main { padding: 1 2 0 2; }
#destination { color: #9eb2cd; height: 1; }
.section-label { color: #78e5d0; text-style: bold; height: 1; }
#quick { border: round #35506e; background: #101e31; margin: 0; }
#quick:focus { border: round #78e5d0; }
.muted { color: #8396b1; height: auto; }
#hint { margin: 0; }
#forwards { height: 1fr; min-height: 4; background: #101b2b; }
DataTable > .datatable--header { background: #20344b; color: #b1c6de; text-style: bold; }
DataTable > .datatable--cursor { background: #255768; color: #ffffff; }
#summary { height: 1; color: #78e5d0; margin-top: 1; }
#details { height: 3; overflow-y: auto; color: #b7c7dd; padding: 0 1; background: #111e30; }
#message { height: 1; color: #efc96a; }
#lifetime { margin-bottom: 0; }
Footer { background: #15243b; }
ModalScreen { align: center middle; background: #050910 75%; }
#edit-dialog, #confirm-dialog, #help-dialog, #settings-dialog { width: 70; max-width: 95%; max-height: 95%; height: auto; padding: 1 2; border: round #78e5d0; background: #142237; }
#focus-scope { height: auto; margin: 1 0; }
#settings-error { height: auto; color: #ff838b; }
#help-dialog { width: 78; }
.dialog-title { color: #78e5d0; text-style: bold; margin-bottom: 1; }
#edit-dialog Input { margin-bottom: 1; }
#edit-error { height: auto; color: #ff838b; }
.buttons { height: 3; margin-top: 1; align-horizontal: right; }
.buttons Button { margin-left: 1; }
